#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_numsymL {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&mo 3>;
                     };

        combo_numsymR {
            timeout-ms = <50>;
            key-positions = <41 42>;
            bindings = <&mo 3>;
                     };

        combo_windows {
            timeout-ms = <50>;
            key-positions = <15 16 17 18>;
            bindings = <&tog 1>;
                     };

        combo_code {
            timeout-ms = <50>;
            key-positions = <47 48 49 50>;
            bindings = <&tog 2>;
                     };

        combo_bltR {
            timeout-ms = <50>;
            key-positions = <6 20 34>;
            bindings = <&tog 4>;
                     };

        combo_bltL {
            timeout-ms = <50>;
            key-positions = <7 21 39>;
            bindings = <&tog 4>;
                     };

        combo_controlMAC {
            timeout-ms = <50>;
            key-positions = <49 50>;
            bindings = <&kp LEFT_CONTROL>;
            layers = <0>;
                     };

        combo_altWIN {
            timeout-ms = <50>;
            key-positions = <49 50>;
            bindings = <&kp LEFT_ALT>;
            layers = <1>;
                     };
          };
};

// Hold-tap behaviors
&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
    quick-tap-ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";


        layer_macOS{
            bindings = < 
      &kp GRAVE             &kp N1             &kp N2         &kp N3    &kp N4     &kp N5  &kp LG(LS(N4))                                                                                            &kp RG(RS(S))  &kp N6  &kp N7  &kp N8      &kp N9    &kp N0    &mt EQUAL MINUS
      &kp DEL               &kp Q              &kp W          &kp E     &kp R      &kp T   &kp LG(LS(N2))                                                                                            &kp RG(F)      &kp Y   &kp U   &kp I       &kp O     &kp P     &mt RA(NUMBER_6) BSLH
      &kp CAPSLOCK          &kp A              &kp S          &kp D     &kp F      &kp G   &mt LG(V) LG(C)                   &kp ESC   &kp RCMD           /**/  &kp RALT          &kp RIGHT_CONTROL   &kp RC(SPACE)  &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
      &kp LSHFT             &kp Z              &kp X          &kp C     &kp V      &kp B                                               &kp C_VOL_UP       /**/  &kp C_MUTE                                           &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
      &kp LG(LA(LS(LCTRL))) &kp LA(LS(LCTRL))  &kp LG(LSHIFT)  &kp LEFT  &kp RIGHT                           &kp SPACE  &kp BACKSPACE  &kp C_VOLUME_DOWN  /**/  &kp C_PLAY_PAUSE  &kp TAB  &kp ENTER                         &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mt RG(RS(N)) RG(N)
            >;
        };

        layer_winOS {
            bindings = <
      &kp GRAVE     &kp N1  &kp N2  &kp N3    &kp N4     &kp N5  &kp LC(LA(DEL))                                                                                             &kp RG(RS(S)) &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &mt EQUAL MINUS
      &kp DEL       &kp Q   &kp W   &kp E     &kp R      &kp T   &kp LA(LS(LCTRL))                                                                                           &kp RC(SQT)   &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
      &kp CAPSLOCK  &kp A   &kp S   &kp D     &kp F      &kp G   &mt LC(V) LC(C)                     &kp ESC  &kp LEFT_CONTROL   /**/  &kp RALT          &kp RCMD            &kp RC(SPACE) &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
      &kp LSHFT     &kp Z   &kp X   &kp C     &kp V      &kp B                                                &kp C_VOL_UP       /**/  &kp C_MUTE                                          &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
      &trans        &trans  &trans  &kp LEFT  &kp RIGHT                             &kp SPACE  &kp BACKSPACE  &kp C_VOLUME_DOWN  /**/  &kp C_PLAY_PAUSE  &kp TAB  &kp ENTER                        &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &kp RC(N)
            >;
        };

        layer_CODE {
            bindings = <
      &kp GRAVE             &kp N1             &kp N2         &kp N3    &kp N4     &kp N5  &kp LG(LS(N4))                                                                                            &kp RG(RS(S))  &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &mt EQUAL MINUS
      &kp DEL               &kp Q              &kp W          &kp E     &kp R      &kp T   &kp LG(LS(N2))                                                                                            &kp RC(GRAVE)  &kp Y   &kp U   &kp I      &kp O     &kp P     &mt RA(NUMBER_6) BSLH
      &kp CAPSLOCK          &kp A              &kp S          &kp D     &kp F      &kp G   &mt LG(V) LG(C)                   &kp ESC  &kp RCMD           /**/  &kp RALT          &kp RIGHT_CONTROL   &kp RC(SPACE)  &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
      &kp LSHFT             &kp Z              &kp X          &kp C     &kp V      &kp B                                              &kp C_VOL_UP       /**/  &kp C_MUTE                                           &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
      &kp LG(LA(LS(LCTRL))) &kp LA(LS(LCTRL))  &kp LG(LSHIFT)  &kp LEFT  &kp RIGHT                          &kp SPACE  &kp BACKSPACE  &kp C_VOLUME_DOWN  /**/  &kp C_PLAY_PAUSE  &kp TAB  &kp ENTER                         &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mt RG(RS(N)) RG(N)
            >;
        };

        layer_NUMSYM {
            bindings = <
      &kp F1 &kp F2  &kp F3  &kp SQT               &kp  APOS               &kp F6  &kp F7                                                      &kp F8  &kp F9     &kp F10    &kp F11  &kp F12     &kp F13      &kp F14
      &none  &none  &none    &kp LEFT_BRACE        &kp  RIGHT_BRACE        &none   &none                                                       &none   &kp PLUS   &kp N7     &kp N8  &kp N9       &kp CARET    &none 
      &none  &none  &none    &kp LEFT_PARENTHESIS  &kp  RIGHT_PARENTHESIS  &none   &none          &trans  &trans /**/  &trans  &trans          &none   &kp MINUS  &kp N4     &kp N5   &kp N6      &kp DOLLAR   &kp HASH 
      &none  &none  &none    &kp LEFT_BRACKET      &kp  RIGHT_BRACKET      &none                         &trans  /**/  &trans                          &kp EQUAL  &kp N1     &kp N2   &kp N3      &kp PERCENT  &none 
      &none  &none  &none    &kp LEFT              &kp  RIGHT                            &trans  &trans  &trans  /**/  &trans  &trans  &trans                     &kp COMMA  &kp N0   &kp KP_DOT  &none        &none 
            >;
        };

layer_SETTINGS {
            bindings = <
      &bootloader  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                                &none         &none  &none  &none  &none  &none  &bootloader
      &none        &none        &none        &none        &none        &none        &none                                                                                &none         &none  &none  &none  &none  &none  &none
      &none        &none        &none        &none        &none        &none        &none                   &none  &none  /**/  &none       &none                        &stp STP_BAT  &none  &none  &none  &none  &none  &none
      &none        &none        &none        &none        &none        &none                                       &none  /**/  &bl BL_INC                                             &none  &none  &none  &none  &none  &none
      &none        &none        &none        &none        &none                         &studio_unlock &bt BT_CLR  &none  /**/  &bl BL_DEC  &bl BL_TOG  &rgb_ug RGB_TOG                       &none  &none  &none  &none  &none
            >;
        };

    };
};
